generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model announcements {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String    @db.VarChar(200)
  body       String?
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model bud_messages {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trigger_page String?  @db.VarChar(50)
  message      String
  bud_pose     String?  @db.VarChar(50)
  is_active    Boolean? @default(true)
}

model certifications {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id    String?       @db.Uuid
  cert_name    String        @db.VarChar(150)
  issuer       String?       @db.VarChar(100)
  year_issued  Int?
  cert_url     String?
  is_verified  Boolean?      @default(true)
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  team_members team_members? @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inquiries {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name        String    @db.VarChar(100)
  email            String    @db.VarChar(150)
  phone            String?   @db.VarChar(20)
  service_category String?   @db.VarChar(50)
  message          String
  status           String?   @default("pending") @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
}

model projects {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id     String?       @db.Uuid
  title         String        @db.VarChar(150)
  description   String?
  thumbnail_url String?
  project_url   String?
  category      String?       @db.VarChar(50)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  team_members  team_members? @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model services {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(100)
  description String?
  category    String?   @db.VarChar(50)
  image_url   String?
  is_free     Boolean?  @default(true)
  price       Decimal?  @default(0.00) @db.Decimal(10, 2)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model team_members {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String           @db.VarChar(100)
  role           String?          @db.VarChar(100)
  bio            String?
  profile_image  String?
  skills         String[]
  stat_design    Int?             @default(0)
  stat_tech      Int?             @default(0)
  stat_strategy  Int?             @default(0)
  portfolio_url  String?
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  certifications certifications[]
  projects       projects[]
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name     String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String
  role          String?   @default("client") @db.VarChar(20)
  avatar_url    String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}
